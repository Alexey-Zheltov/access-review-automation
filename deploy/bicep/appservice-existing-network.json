    "identityName": "[format('id-{0}', parameters('appName'))]",
    "serverName": "[if(empty(parameters('postgresServerName')), format('psql-{0}', parameters('appName')), parameters('postgresServerName'))]",
    "vaultName": "[if(empty(parameters('keyVaultName')), format('kv-{0}', uniqueString(resourceGroup().id, parameters('appName'))), parameters('keyVaultName'))]",
    "subnetIdPart": "/providers/microsoft.network/virtualnetworks/",
    "badSubnetParameters": "[concat(if(and(contains(toLower(parameters('appSubnetResourceId')), variables('subnetIdPart')), contains(toLower(parameters('appSubnetResourceId')), '/subnets/')), createArray(), createArray('appSubnetResourceId')), if(and(contains(toLower(parameters('privateEndpointSubnetResourceId')), variables('subnetIdPart')), contains(toLower(parameters('privateEndpointSubnetResourceId')), '/subnets/')), createArray(), createArray('privateEndpointSubnetResourceId')))]",
    "appSubnetId": "[if(empty(variables('badSubnetParameters')), parameters('appSubnetResourceId'), fail(format('Give the resource id of an existing subnet (/subscriptions/<id>/resourceGroups/<group>/providers/Microsoft.Network/virtualNetworks/<vnet>/subnets/<subnet>) in: {0}', join(variables('badSubnetParameters'), ', '))))]",
    "endpointSubnetId": "[parameters('privateEndpointSubnetResourceId')]",
    "vnetId": "[substring(variables('appSubnetId'), 0, lastIndexOf(variables('appSubnetId'), '/subnets/'))]",
    "createSiteZone": "[empty(parameters('webAppPrivateDnsZoneResourceId'))]",
    "createPostgresZone": "[and(variables('createPostgres'), empty(parameters('postgresPrivateDnsZoneResourceId')))]",
    "createVaultZone": "[empty(parameters('keyVaultPrivateDnsZoneResourceId'))]",
    "siteZoneId": "[if(variables('createSiteZone'), resourceId('Microsoft.Network/privateDnsZones', 'privatelink.azurewebsites.net'), parameters('webAppPrivateDnsZoneResourceId'))]",
    "postgresZoneId": "[if(variables('createPostgresZone'), resourceId('Microsoft.Network/privateDnsZones', 'privatelink.postgres.database.azure.com'), parameters('postgresPrivateDnsZoneResourceId'))]",
    "vaultZoneId": "[if(variables('createVaultZone'), resourceId('Microsoft.Network/privateDnsZones', 'privatelink.vaultcore.azure.net'), parameters('keyVaultPrivateDnsZoneResourceId'))]"
  },
  "resources": [
    {
