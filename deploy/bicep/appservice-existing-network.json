      "type": "string",
      "metadata": {
        "description": "Application (client) id of the app registration (setup-sp.ps1 prints it)."
      }
    },
    "clientSecret": {
      "type": "securestring",
      "metadata": {
        "description": "Client secret of the app registration."
      }
