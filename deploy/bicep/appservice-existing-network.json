        "description": "Existing private DNS zone privatelink.vaultcore.azure.net. Empty = create one in this resource group and link it to the VNet of the app subnet."
      }
    },
    "databaseServer": {
      "type": "string",
      "defaultValue": "AzurePostgreSQL",
      "allowedValues": [
