# Copy this file to .env and fill in the values. Do not commit or share .env.

# ---------------------------------------------------------------- web endpoint
# Host port of the portal.
WEB_PORT=8088
# Container port: 8443 = HTTPS with the certificate below (needed for Microsoft Entra ID sign-in on a non-localhost address).
# Use 8080 (plain HTTP) only behind a reverse proxy that terminates TLS; then also set ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
# and remove the three HTTPS lines.
WEB_CONTAINER_PORT=8443
ASPNETCORE_HTTPS_PORTS=8443
ASPNETCORE_Kestrel__Certificates__Default__Path=/https/portal.pfx
ASPNETCORE_Kestrel__Certificates__Default__Password=
# Public address of the portal (used in notification links). Example: https://accessreview.contoso.com:8088
Portal__PublicBaseUrl=

# ---------------------------------------------------------------- database
# Use a random password without ; or spaces, e.g.: openssl rand -hex 24
POSTGRES_DB=accessreview
POSTGRES_USER=accessreview
POSTGRES_PASSWORD=
# Host port for administration (bound to 127.0.0.1 only).
DB_HOST_PORT=5435
# The "migrate" service (EF Core migration bundle) updates the schema before the portal starts.
# Set true only if you run the portal without the migrate step.
Database__ApplyMigrationsOnStartup=false

# ---------------------------------------------------------------- Microsoft Entra ID
# App registration created by setup-sp.ps1 (it can write these values for you with -EnvFile .env).
# The app has READ-ONLY application permissions (scanner) and delegated permissions (revoke as the signed-in user).
AzureAd__TenantId=
AzureAd__ClientId=
AzureAd__ClientSecret=

# EntraId (default): users sign in with Microsoft Entra ID; revoke runs with their own token.
# AccessKey: fallback with a shared key; review and Excel only, no revoke from the portal.
Authentication__Mode=EntraId
# Also offer "sign in with a code on another device" (device code flow).
Authentication__EnableDeviceCodeSignIn=true
# Users need the app role AccessReview.Admin or AccessReview.Reviewer (assigned in Enterprise applications).
Authorization__RequireAppRole=true
# Only for Authentication__Mode=AccessKey.
Portal__AccessKey=

# ---------------------------------------------------------------- scan
# Default inactivity threshold. It can be changed in the UI.
ReviewSettings__InactivityThresholdDays=90
# Optional: Log Analytics workspace id (GUID) that receives AzureActivity and SigninLogs.
# With it the scanner uses authorization.evidence (exact attribution) and 90 days of sign-ins.
ReviewSettings__LogAnalyticsWorkspaceId=
# Read Microsoft Defender for Cloud CSPM (CIEM) recommendations during the scan.
DefenderCspm__Enabled=true
# Subscriptions are selected on the Subscriptions page ("Monitor in Portal"). New subscriptions are monitored by default.
Discovery__MonitorNewSubscriptionsByDefault=true

# ---------------------------------------------------------------- automation (defaults; can be changed on the Automation page)
Automation__MonthlySnapshotEnabled=true
Automation__QuarterlyCampaignEnabled=true
# Optional webhook (Power Automate "When an HTTP request is received", Logic Apps, Teams workflow).
Automation__NotificationWebhookUrl=
